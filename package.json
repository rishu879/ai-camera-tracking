{
  "name": "ai-camera-tracking",
  "version": "1.0.0",
  "description": "Autonomous AI-assisted virtual camera tracking system for mobile Free Space Optical Communication (FSOC) coarse pointing, developed for ISRO Smart India Hackathon (SIH).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/start.ps1",
    "doctor": "powershell -ExecutionPolicy Bypass -File ./scripts/doctor.ps1",
    "build": "vite build",
    "preview": "vite preview",
    "start": "python server.py",
    "server": "python server.py",
    "test": "pytest"
  },
  "devDependencies": {
    "vite": "^6.2.0"
  }
}
