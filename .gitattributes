# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force scripts to LF
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf

# PowerShell scripts can use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.pdf binary
*.onnx binary
